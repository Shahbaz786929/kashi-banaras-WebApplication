DATABASE_URL=jdbc:mysql://mysql:3306/kashi_banaras
DATABASE_USERNAME=kashi_app
DATABASE_PASSWORD=change_me_app

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Razorpay (test mode keys from dashboard.razorpay.com) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI Color Studio (Google Gemini image edit — free tier at ai.google.dev) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_DAILY_GENERATION_LIMIT_PER_USER=10
AI_MAX_IMAGE_SIZE_MB=8

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Misc ----
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Development seed only ----
DEV_ADMIN_PASSWORD=ChangeMe123!
DEV_CUSTOMER_PASSWORD=ChangeMe123!
AI_COLOR_PREVIEW_ENABLED=true
